						(size 1.016 1.016)
					)
				)
			)
			(property "Boot Strap Notes" "GPIO35-GPIO38: boot mode strapping; GPIO34: JTAG source strapping; GPIO36: ROM print control. GPIO37/UART0_TXD and GPIO38/UART0_RXD are UART download pins. GPIO35 held high selects default SPI boot; GPIO35 low GPIO36 high selects joint download boot. CHIP_PU has 10k internal pull-up."
				(at -4.318 -75.184 0)
				(show_name no)
				(do_not_autoplace no)
				(hide yes)
				(effects
