			(property "Description" "Wireless-Tag ESP32-P4 core module, 82 castellated pads, 16MB NOR flash, 16/32MB PSRAM. 5V VCC. Pinout from WT0132P4-A1 datasheet v2.1, pages 9-13."
				(at 7.62 -74.93 0)
				(show_name no)
				(do_not_autoplace no)
				(hide yes)
				(effects
					(font
						(size 1.016 1.016)
					)
				)
			)
			(property "Boot Strap Notes" "GPIO35-GPIO38: boot mode strapping; GPIO34: JTAG source strapping; GPIO36: ROM print control. GPIO37/UART0_TXD and GPIO38/UART0_RXD are UART download pins. GPIO35 held high selects default SPI boot; GPIO35 low GPIO36 high selects joint download boot. CHIP_PU has 10k internal pull-up."
				(at -4.318 -75.184 0)
				(show_name no)
				(do_not_autoplace no)
				(hide yes)
				(effects
					(font
						(size 1.016 1.016)
					)
				)
			)
			(property "Power Notes" "VCC module input: 4.8-5.5V, typical supply capability 1A. ESP_LDO_VO4 is a configurable LDO OUTPUT rated max 200mA (0.5-2.7V or 3.3V), not an input."
				(at 1.778 -75.184 0)
