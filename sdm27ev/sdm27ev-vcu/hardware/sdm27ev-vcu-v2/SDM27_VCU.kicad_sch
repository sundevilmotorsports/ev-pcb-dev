	(text "Test points \n  TP3  +12V       protected 12 V after F1 / D17 / D18 ~11.6 V (12 V in - SS14 drop)\n  TP2  5V_BUCK    TPS563211 output (SMPS ~5.07 V\n  TP4  E5V        TPS2121 mux output, feeds Nucleo E5V ~5 V\n  TP5  +3.3V      TPS62901 output ~3.3 V\n  TP6  CLAMP_REF  MCP1700 AFE clamp reference ~2.8 V"
		(exclude_from_sim no)
		(at 70.485 135.255 0)
		(effects
