	)
	(text "Both inputs: 9-16V operating; +/-60V bounded input stress evaluation.\n2 x 10k series, reverse B-E clamp, 100k default-off, 4.7k / 100n filter.\nVoltage presence only: not a precise undervoltage or AIR-position detector."
		(exclude_from_sim no)
		(at 140 154 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "c7f33708-68a0-4801-b7d9-34fe581c2ea8")
	)
	(text "U20 = ALL_CLEAR_N AND ARM_CLEAN AND ARM_REQUALIFIED.\nU24 (sheet 2) adds monitored 5V status to the clear path.\nU23 gate 3 qualifies both passive RUN key returns."
		(exclude_from_sim no)
		(at 15 249 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "fa05514e-8f0b-409d-bf77-0efbe86cf4d6")
	)
	(text "J1.4 feeds BOTH coil positives after F2.\nSDC switches +12V externally; no GLV+ bypass.\nJ1.7: fresh momentary +12V start request.\nNo CAN transceiver; pin 8 stays sealed like mahoraga."
		(exclude_from_sim no)
		(at 15 103 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "fe67aff2-bd00-489b-bb74-61c04fc0aebb")
	)
