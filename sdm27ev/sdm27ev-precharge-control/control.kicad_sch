		)
		(uuid "a80dcc37-79b6-47f9-bcbc-bb95454be850")
	)
	(text "Hold J9 pin 5 LOW, then cycle controller power for ROM download.\nJ9 pin 4 is 3.3 V tool power. Do not ground pin 4."
		(exclude_from_sim no)
		(at 20 150 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "aff78d42-09fa-460c-ad8b-921da352042c")
	)
	(text "U20 = ARM_CLEAN AND ARM_REQUALIFIED AND ALL_CLEAR_N.\nSDC / service / either monitored rail clears the re-arm latch."
