		(uuid "0cf167ae-81e7-4cdb-9c5a-f5f853340870")
	)
	(text "GPIO5 = SDC_PRESENT; GPIO7 = START_REQUEST (both inputs). GPIO20 = OUTPUT_ARM.\nBoot, SDC loss and service exit require fresh start; never restore actuator state from NVM."
		(exclude_from_sim no)
		(at 20 259 0)
		(effects
			(font
				(size 1.45 1.45)
			)
			(justify left top)
		)
		(uuid "35e4eb48-f899-4179-ac01-cf30966fc6e4")
	)
	(text "J9 accepts RUN key OR isolated service tool. SERVICE plug populates pins 1-5 only.\nRemoving key opens both returns; restarting requires a fresh ARM edge."
		(exclude_from_sim no)
		(at 212 23 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "4d6e2771-bb7d-48fd-a991-d9baf725fb9d")
	)
	(text "GPIO0/1 read the four-channel voltage monitor using I2C."
		(exclude_from_sim no)
		(at 20 23 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "905a7c26-faa8-4919-8c0e-e3dde3ac027f")
	)
	(text "Service connections"
		(exclude_from_sim no)
		(at 212 18 0)
		(effects
