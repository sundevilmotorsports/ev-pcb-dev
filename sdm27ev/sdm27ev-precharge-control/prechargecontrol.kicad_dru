(version 1)
(rule "0.2mm existing thermal PTH only" (condition "A.Type == 'Pad' && ((A.Reference == 'U1' && A.Pad_Number == '9') || (A.Reference == 'U7' && A.Pad_Number == '9') || (A.Reference == 'U2' && A.Pad_Number == '19'))") (constraint hole_size (min 0.20mm)))
(rule "All other PTH holes" (condition "!(A.Type == 'Pad' && ((A.Reference == 'U1' && A.Pad_Number == '9') || (A.Reference == 'U7' && A.Pad_Number == '9') || (A.Reference == 'U2' && A.Pad_Number == '19')))") (constraint hole_size (min 0.30mm)))
(rule "U22 DCU manufacturer lands" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == 'U22' && B.Reference == 'U22'") (constraint clearance (min 0.15mm)))
(rule "Isolated domain to GLV" (condition "((A.NetClass == 'PACK_ISO' || A.NetClass == 'DC_ISO') && !(B.NetClass == 'PACK_ISO' || B.NetClass == 'DC_ISO')) || ((B.NetClass == 'PACK_ISO' || B.NetClass == 'DC_ISO') && !(A.NetClass == 'PACK_ISO' || A.NetClass == 'DC_ISO'))") (constraint clearance (min 8.10mm)))
(rule "PACK to DC domains" (condition "(A.NetClass == 'PACK_ISO' && B.NetClass == 'DC_ISO') || (A.NetClass == 'DC_ISO' && B.NetClass == 'PACK_ISO')") (constraint clearance (min 20mm)))

(rule "J2 local high-voltage termination separation"
    (condition "((A.NetName == 'Net-(J2-Pin_1)' && B.NetClass == 'PACK_ISO' && B.NetName != 'Net-(J2-Pin_1)') || (B.NetName == 'Net-(J2-Pin_1)' && A.NetClass == 'PACK_ISO' && A.NetName != 'Net-(J2-Pin_1)'))")
    (constraint clearance (min 4.20mm)))

(rule "J3 local high-voltage termination separation"
    (condition "((A.NetName == 'Net-(J3-Pin_1)' && B.NetClass == 'DC_ISO' && B.NetName != 'Net-(J3-Pin_1)') || (B.NetName == 'Net-(J3-Pin_1)' && A.NetClass == 'DC_ISO' && A.NetName != 'Net-(J3-Pin_1)'))")
    (constraint clearance (min 4.20mm)))
