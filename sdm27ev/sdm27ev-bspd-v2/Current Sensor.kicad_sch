	(text "This circutry is happning on the BMS side of the isolation between BMS and BSPD.\nThis is because the sensor has a max output of 1mA, and I could not find any way to isolate it without bringing BMS 5V here.\nAt that point, we might as well do the digital comparison beforehand, and then isolate the signal."
		(exclude_from_sim no)
		(at 16.002 18.542 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "07d500af-e550-4441-80e1-1f8603957726")
	)
	(text "Used to set >5kW\nAssuming this is a 330V battery, this should be ~3V"
		(exclude_from_sim no)
		(at 81.788 27.432 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "18e4a714-4765-46a4-9244-8e85b74fddbf")
	)
	(text "BSPD SIDE"
		(exclude_from_sim no)
		(at 75.946 200.152 0)
		(effects
			(font
				(size 2.54 2.54)
			)
		)
		(uuid "18ef43ff-dfca-4c93-acf9-98f8927372b6")
	)
	(text "Used to set when the sensor is not comunicating with the BSPD\nSould be ~0.5V"
		(exclude_from_sim no)
		(at 153.924 28.194 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4a71585f-849d-46ad-acf8-5cf3dd502b3f")
	)
	(text "Lines have 2.5mA when being driven high\nLines are HIGH on fault, and \nLOW under normal opperation,\nPut even larger pull up's on main board"
		(exclude_from_sim no)
		(at 17.78 197.104 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "96371163-9fcc-4f9b-808f-3be7faf3d3af")
	)
	(text "Comparitor goes high-impedance when + > -\nComparitor goes LOW when - > +\n"
		(exclude_from_sim no)
		(at 50.546 67.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b6b19961-55da-4464-bb05-4e71cd894f72")
	)
	(text "Brightness: 10mcd\nΔV = 5V - 2.7V = 2.3V\nV/I = 2.3V / 0.5mA = 4600Ω\n4.6k ≈ 4.7kΩ\nLED Current Draw: 0.5mA"
		(exclude_from_sim no)
		(at 17.526 173.736 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f73c3c16-1a50-4eda-9c06-da8eadda1d6d")
	)
