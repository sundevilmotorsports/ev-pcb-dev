	(text "Batt. Nominal: 330V\nTrip Power: 5kW\nTrip Current: P = IV ⇒ I = P/V\nI = 5000W/330V = 15.15A\n\nCurrent per loop = I / n_{loops}\nI_{test} = 15.15A/15 ≈ 1A\n"
		(exclude_from_sim no)
		(at 126.492 191.516 0)
